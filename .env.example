# Copy to .env and fill in. NEVER commit .env.
# This file IS committed — keep real passwords out of it.
# See docs/01-tech-stack-and-environment.md §5

APP_ENV=local
APP_DEBUG=true

# Public base URL. The webhook and redirect URLs are built from this,
# so it must be reachable BY INSTAMOJO in production, not just by you.
APP_URL="http://localhost:8000"

# ---- Database ----
# PDO DSN for the API and jobs. Credentials go in the two vars below,
# NOT in the DSN string — PDO takes them as separate arguments.
FEED_DB_DSN="pgsql:host=localhost;port=5432;dbname=postgres"
FEED_DB_USER="postgres"
FEED_DB_PASS=""

# libpq-style URL, used by psql and pg_dump in cron.
# The password must be PERCENT-ENCODED here — this is a URI, so a literal
# #, @, / or : in the password will be misparsed and the connection fails.
#   #  ->  %23      @  ->  %40      /  ->  %2F      :  ->  %3A
FEED_DB_URL="postgresql://postgres:PERCENT_ENCODED_PASSWORD@localhost:5432/postgres"

# ---- Auth ----
TOKEN_TTL_DAYS=90

# ---- Payments ----
# Master switch. While false, POST /api/donation/create refuses with
# PAYMENTS_DISABLED, the sandbox payment page 404s, and the app shows the
# UPI id below instead of a payment button.
#
# The webhook stays live either way, on purpose: switching payments off
# must not swallow the confirmation of a payment already in flight.
PAYMENTS_ENABLED=false

# Shown on screen for people to pay into, so it is PUBLIC by design — not
# a secret like the keys below. The app reads it from GET
# /api/donation/info, so changing it here takes effect without a new
# app build.
DONATION_UPI_ID="yourname@bank"
DONATION_UPI_NAME="FinePrint"

# ---- Instamojo ----
# Sandbox by default so a real payment cannot be taken in development.
# Production is https://www.instamojo.com/api/1.1/
INSTAMOJO_API_KEY=""
INSTAMOJO_AUTH_TOKEN=""
INSTAMOJO_SALT=""
INSTAMOJO_BASE_URL="https://test.instamojo.com/api/1.1/"

# ---- Feed fetch job ----
FEED_USER_AGENT="BlogFeedApp/1.0 (+https://yourdomain.com/about)"
FEED_HTTP_TIMEOUT=15
FEED_MAX_FAILURES=5
FEED_EXCERPT_CHARS=200
