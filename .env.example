# Copy to .env and fill in. NEVER commit .env.
# This file IS committed — keep real passwords out of it.
# See docs/01-tech-stack-and-environment.md §5

APP_ENV=local
APP_DEBUG=true

# ---- Database ----
# PDO DSN for the API and jobs. Credentials go in the two vars below,
# NOT in the DSN string — PDO takes them as separate arguments.
FEED_DB_DSN="pgsql:host=localhost;port=5432;dbname=postgres"
FEED_DB_USER="postgres"
FEED_DB_PASS=""

# libpq-style URL, used by psql and pg_dump in cron.
# The password must be PERCENT-ENCODED here — this is a URI, so a literal
# #, @, / or : in the password will be misparsed and the connection fails.
#   #  ->  %23      @  ->  %40      /  ->  %2F      :  ->  %3A
FEED_DB_URL="postgresql://postgres:PERCENT_ENCODED_PASSWORD@localhost:5432/postgres"

# ---- Auth ----
TOKEN_TTL_DAYS=90

# ---- Instamojo ----
# Sandbox by default so a real payment cannot be taken in development.
# Production is https://www.instamojo.com/api/1.1/
INSTAMOJO_API_KEY=""
INSTAMOJO_AUTH_TOKEN=""
INSTAMOJO_SALT=""
INSTAMOJO_BASE_URL="https://test.instamojo.com/api/1.1/"

# ---- Feed fetch job ----
FEED_USER_AGENT="BlogFeedApp/1.0 (+https://yourdomain.com/about)"
FEED_HTTP_TIMEOUT=15
FEED_MAX_FAILURES=5
FEED_EXCERPT_CHARS=200
