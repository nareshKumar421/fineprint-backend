{
    "name": "blogfeed/backend",
    "description": "Blog Feed App — PHP API and cron jobs",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "ext-mbstring": "*",
        "ext-dom": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
